<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://www.w3.org/2001/XMLSchema.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ainvr</groupId>
    <artifactId>ainvr</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>aiNVR</name>
    <description>aiNVR：AI 增强小米摄像头 NVR（miss/mess + CS2 私有协议直连、画面变动侦测与本地 AI 事件、Web 控制台），基于 i-nvr by IndSvr 以 GPL-2.0 二次开发</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <okhttp.version>4.12.0</okhttp.version>
        <jackson.version>2.17.2</jackson.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <slf4j.version>2.0.13</slf4j.version>
        <junit.version>5.10.2</junit.version>
        <javacpp.version>1.5.10</javacpp.version>
        <ffmpeg.version>6.1.1-1.5.10</ffmpeg.version>
        <netty.version>4.1.115.Final</netty.version>
    </properties>

    <!-- 依赖：Spring Boot Web + 米家云(OkHttp/Jackson) + 密码学(BouncyCastle) + Netty + JavaCV/FFmpeg(Windows+Linux 双平台 native) + 测试 -->
    <dependencies>
        <!-- Spring Boot Web（内嵌 Tomcat + Spring MVC）；排除默认 logback，沿用 slf4j-simple -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- HTTP 客户端：米家云账号登录与业务 API -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- v2.3.1 对讲喊话：WebSocket 音频上行（浏览器麦克风 → CS2 通道 3 → 摄像头扬声器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- v2.3.1 Home Assistant 接入：MQTT 客户端（Eclipse Paho，事件发布 + HA discovery） -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- v2.1.0 A2 本地 AI 检测：ONNX Runtime 推理（MIT），运行 SSD-MobileNetV1（MIT，ONNX Model Zoo）
             对事件快照做本地人/车/宠物分类。全平台 natives 约 93MB，启动仅解压当前平台的一份。 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- X25519 / ChaCha20 / RC4 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- RTSP 下行服务（M4）：Netty 作 TCP/线程框架，RTSP 信令与 RTP 打包手写 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${netty.version}</version>
        </dependency>

        <!-- 进程内 FFmpeg（MP4 录像流拷贝 / HLS 切片）。平台 native 由下方 profiles 提供：
             默认构建 Windows + Linux x86_64 双平台（本地调试能力不变），
             -Pfnos 只打 Linux x86_64 供 fpk 使用。JavaCPP 按 os.name/os.arch 自动选库，
             无需在目标系统安装 ffmpeg。如需 ARM 服务器，再追加 classifier=linux-arm64 即可。 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>${ffmpeg.version}</version>
        </dependency>

        <!-- 日志：slf4j-simple（全项目统一） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ainvr</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- CLI 调试：mvn exec:java -Dexec.args="devices" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.ainvr.AinvrApplication</mainClass>
                </configuration>
            </plugin>

            <!-- 可执行 fat jar：java -jar target/ainvr.jar（默认启动 Web 服务） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ainvr.web.NvrWebApplication</mainClass>
                    <!-- JavaCPP/FFmpeg 需从嵌套 jar 解压出 native 库后才能加载 -->
                    <requiresUnpack>
                        <dependency>
                            <groupId>org.bytedeco</groupId>
                            <artifactId>javacpp</artifactId>
                        </dependency>
                        <dependency>
                            <groupId>org.bytedeco</groupId>
                            <artifactId>ffmpeg</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ===== 平台原生库分发 =====
         desktop（默认）：Windows + Linux x86_64 双平台，保持历史 fat jar 能力，
                          本地 Windows / macOS 可直接 java -jar 调试。
         fnos（mvn package -Pfnos）：只含 Linux x86_64，产物 target/ainvr-fnos.jar。
         fnOS 运行在 Linux x86_64，Windows 的 .dll 永远不会被 JavaCPP 加载；
         去掉后 fat jar 小 23 MiB，且 requiresUnpack 启动时少解压一个 23 MiB 的
         native 包（冷启动 / 升级后首次启动明显变快），功能完全不变。 -->
    <profiles>
        <profile>
            <id>desktop</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>ffmpeg</artifactId>
                    <version>${ffmpeg.version}</version>
                    <classifier>windows-x86_64</classifier>
                </dependency>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>ffmpeg</artifactId>
                    <version>${ffmpeg.version}</version>
                    <classifier>linux-x86_64</classifier>
                </dependency>
                <!-- macOS（Apple Silicon）：本机测试/调试用（如 AAC 音轨端到端测试需本地加载 ffmpeg native） -->
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>ffmpeg</artifactId>
                    <version>${ffmpeg.version}</version>
                    <classifier>macosx-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>fnos</id>
            <dependencies>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>ffmpeg</artifactId>
                    <version>${ffmpeg.version}</version>
                    <classifier>linux-x86_64</classifier>
                </dependency>
            </dependencies>
            <build>
                <finalName>ainvr-fnos</finalName>
            </build>
        </profile>
    </profiles>
</project>
