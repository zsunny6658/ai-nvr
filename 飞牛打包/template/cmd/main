#!/bin/bash
APP_JAR="${TRIM_APPDEST}/app.jar"
JAVA_BIN="${TRIM_APPDEST}/jre/bin/java"
VAR_DIR="${TRIM_PKGVAR}"
LOG_DIR="${VAR_DIR}/logs"
PID_FILE="${VAR_DIR}/app.pid"
SOCK_FILE="${TRIM_APPDEST}/app.sock"
APP_PATH="/app/indsvr-invr/"

if [ -f "${TRIM_PKGETC}/jvm.conf" ]; then
  source "${TRIM_PKGETC}/jvm.conf"
else
  JAVA_OPTS="-Xms128m -Xmx512m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
fi
# 日志重定向到 app.log 时，JDK 17/21 的 stdout/stderr 编码取自平台 locale；
# fnOS 容器多为 C/POSIX，会把中文全部写成 '?'，排障时无法读日志。
# 显式固定输出编码，且无论是否使用自定义 jvm.conf 都追加。
JAVA_OPTS="${JAVA_OPTS} -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"

SPRING_ARGS="--spring.config.additional-location=file:${TRIM_PKGETC}/ --spring.profiles.active=fnos"
mkdir -p "${LOG_DIR}"

# 按「java 进程 + 完整 jar 路径」列出本应用的进程。
# 不能只依赖 app.pid：覆盖安装 / 升级会重建应用目录，pid 文件可能丢失，
# 旧进程随即变成孤儿继续占用 service_port，导致 fnOS checkport 报「端口被占用」。
app_pids() {
  ps -eo pid=,comm=,args= 2>/dev/null \
    | awk -v jar="${APP_JAR}" '$2=="java" && index($0, jar)>0 {print $1}'
}

stop_all() {
  local p
  for p in $(app_pids); do
    kill "$p" 2>/dev/null
  done
  for i in $(seq 1 10); do
    [ -z "$(app_pids)" ] && break
    sleep 1
  done
  for p in $(app_pids); do
    kill -9 "$p" 2>/dev/null
  done
  rm -f "$PID_FILE" "$SOCK_FILE"
}

case $1 in
  start)
    # 幂等：先清掉可能残留的旧进程（含 pid 文件丢失的孤儿进程），释放 9099 / 9554
    stop_all
    if [ ! -f "$APP_JAR" ]; then
      echo "jar not found: $APP_JAR" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
      exit 1
    fi
    chmod +x "${TRIM_APPDEST}/jre/bin/"* 2>/dev/null
    # 顺序预读 fat jar 到页缓存，降低冷启动时组件扫描的随机 IO 延迟
    cat "$APP_JAR" > /dev/null 2>/dev/null
    # 切换工作目录到持久化数据目录，这样应用写的 .invr/ 会落在 var 下
    cd "${TRIM_PKGVAR}"
    # setsid 让 java 脱离启动脚本的会话：即使上层启用流程超时，也不会连带终止服务
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "${JAVA_BIN}" ${JAVA_OPTS} -jar "${APP_JAR}" ${SPRING_ARGS} > "${LOG_DIR}/app.log" 2>&1 &
    else
      nohup "${JAVA_BIN}" ${JAVA_OPTS} -jar "${APP_JAR}" ${SPRING_ARGS} > "${LOG_DIR}/app.log" 2>&1 &
    fi
    sleep 1
    # setsid 可能 fork，用真实 java pid 回写 pid 文件
    for p in $(app_pids); do echo "$p" > "$PID_FILE"; done
    sleep 2
    chmod 666 "$SOCK_FILE" 2>/dev/null
    pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      echo "App failed to start. Check log: ${LOG_DIR}/app.log" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
      exit 1
    fi
    # 关键：等应用真正能响应 HTTP 再返回。
    # 冷启动可能长达 100s 以上；若只 sleep 3 就返回，fnOS 会立刻把应用标为
    # 「已启用」，用户此时点开，网关连尚未创建的 UDS socket 必然 502 Bad Gateway。
    # 同时 socket 是启动后期才创建的，这里再修一次 666 权限（nginx 需要）。
    # 超时也返回成功：java 已由 setsid 独立运行，不会被上层超时连带杀掉。
    CURL_BIN=$(command -v curl 2>/dev/null || echo /usr/bin/curl)
    READY_MAX=120
    for i in $(seq 1 60); do
      if [ -S "$SOCK_FILE" ]; then
        chmod 666 "$SOCK_FILE" 2>/dev/null
        if [ ! -x "$CURL_BIN" ] || "$CURL_BIN" --unix-socket "$SOCK_FILE" -s -o /dev/null --max-time 2 "http://localhost${APP_PATH}" 2>/dev/null; then
          exit 0
        fi
      fi
      sleep 2
    done
    echo "[main] app not ready within ${READY_MAX}s; java kept running, check app.log" >> "${LOG_DIR}/app.log"
    exit 0
    ;;
  stop)
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" | tr -d '[:space:]')
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
      fi
    fi
    # 兜底清理：即使 pid 文件丢失，也要按 jar 路径杀掉孤儿进程
    stop_all
    exit 0
    ;;
  status)
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" | tr -d '[:space:]')
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        exit 0
      fi
      rm -f "$PID_FILE"
    fi
    # pid 文件丢失但进程仍在时如实上报，便于 fnOS 先执行 stop 再启用
    [ -n "$(app_pids)" ] && exit 0
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
