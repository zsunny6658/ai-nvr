#!/bin/bash
ETC_DIR="${TRIM_PKGETC}"
VAR_DIR="${TRIM_PKGVAR}"
mkdir -p "${ETC_DIR}" "${VAR_DIR}/logs" "${VAR_DIR}/data"

# 从 target 目录里的 manifest 读取端口（fnpack 会把 manifest 规范化成 "key = value" 带空格格式，
# 所以 grep 要兼容等号两边的空白）
SERVER_PORT=$(grep -E "^service_port[[:space:]]*=" "${TRIM_APPDEST}/manifest" | cut -d= -f2 | tr -d ' ')
SERVER_PORT=${SERVER_PORT:-9099}

# 安装向导里用户输入的 JVM 配置
JVM_XMX="${wizard_jvm_xmx:-512}"
JVM_XMS="${wizard_jvm_xms:-128}"

# 生成 Spring Boot 配置：
# - port 从 manifest 读取（TCP 双监听保留，checkport 健康检查用）
# - context-path 必须与 ui/config 的 gatewayPrefix 一致：统一网关转发请求时不剥离前缀，
#   应用收到的就是 /app/ainvr/... 原始路径
# - use-relative-redirects: true 必须开启。UDS 转发会丢失外部 Host，Spring Boot 默认
#   对无尾斜杠路径生成绝对重定向 Location: http://localhost/app/ainvr/，
#   浏览器会跳到自身 localhost 而报 "Not Found"。开启后 Location 变为相对路径
#   /app/ainvr/，浏览器在当前域名下正确补斜杠。
# - ainvr.uds-socket 把 socket 路径在安装时固化写入配置（v2.2.0 前为 invr.uds-socket，安装时会被本文件整体重写），服务进程不再依赖
#   运行时环境变量 TRIM_APPDEST（fnOS 不保证把它注入给 cmd/main 的子进程）
cat > "${ETC_DIR}/application-fnos.yml" <<EOFCONF
server:
  port: ${SERVER_PORT}
  servlet:
    context-path: /app/ainvr
  tomcat:
    use-relative-redirects: true
ainvr:
  uds-socket: ${TRIM_APPDEST}/app.sock
EOFCONF

# 生成 JVM 配置
cat > "${ETC_DIR}/jvm.conf" <<EOFJVM
JAVA_OPTS="-Xms${JVM_XMS}m -Xmx${JVM_XMX}m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
EOFJVM

chmod +x "${TRIM_APPDEST}/jre/bin/"* 2>/dev/null

exit 0
